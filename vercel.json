{
  "functions": {
    "app.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/assets/music/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Content-Type",
          "value": "audio/mpeg"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/assets/music/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    }
  ]
}